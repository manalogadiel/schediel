<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: paper background and the vector mark the in-app intro continues. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vector</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
